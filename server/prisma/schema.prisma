generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid()) @map("id")
  name               String              @map("name")
  email              String              @unique @map("email")
  roll               String              @unique @map("roll")
  password           String              @map("password")
  selfie             String              @default("absent") @map("selfie")
  idCardFront        String              @default("absent") @map("id_card_front")
  idCardBack         String              @default("absent") @map("id_card_back")
  ipAddress          String?             @map("ip_address")
  latitude           Float?              @map("latitude")
  longitude          Float?              @map("longitude")
  role               Role                @default(USER) @map("role")
  emailVerified      Boolean             @default(false) @map("email_verified")
  isVerified         VerifyStatus        @default(UNVERIFIED) @map("is_verified")
  otp                String?             @map("otp")
  otpExpiry          DateTime?           @map("otp_expiry")
  otpSentCount       Int                 @default(0) @map("otp_sent_count")
  lastOtpSentDate    DateTime?           @map("last_otp_sent_date")
  safetyScore        Int                 @default(0) @map("safety_score")
  creditTransactions CreditTransaction[]
  rentedProducts     Product[]           @relation("RentedProducts")
  borrowedProducts   Product[]           @relation("BorrowedProducts")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([latitude, longitude])
  @@map("users")
}

enum VerifyStatus {
  UNVERIFIED
  VERIFIED
  PENDING
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model CreditTransaction {
  id              String       @id @default(cuid()) @map("id")
  userId          String       @map("user_id")
  amount          Float        @map("amount")
  creditType      CreditType   @map("credit_type")
  sourceType      CreditSource @map("source_type")
  sourceProductId String?      @map("source_product_id")
  renterId        String?      @map("renter_id")
  instantFee      Float?       @map("instant_fee")
  validityStart   DateTime     @map("validity_start")
  validityEnd     DateTime     @map("validity_end")
  isActive        Boolean      @default(true) @map("is_active")
  user            User         @relation(fields: [userId], references: [id])
  sourceProduct   Product?     @relation(fields: [sourceProductId], references: [id])
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("credit_transactions")
}

enum CreditType {
  BLUE
  RED
}

enum CreditSource {
  PRODUCT
  MONEY
  INSTANT
}

model Product {
  id                 String              @id @default(cuid()) @map("id")
  name               String              @map("name")
  pricePerDay        Float?              @map("price_per_day")
  productImages      String[]            @map("product_images")
  productType        ProductType         @map("product_type")
  productAge         String              @map("product_age")
  omv                Int                 @map("omv")
  tags               String              @map("tags")
  productDescription String              @map("product_description")
  ownerId            String              @map("owner_id")
  borrowerId         String?             @map("borrower_id")
  isOnHold           Boolean             @default(false) @map("is_on_hold")
  holdCreditValidity Int?                @map("hold_credit_validity")
  owner              User                @relation("RentedProducts", fields: [ownerId], references: [id])
  borrower           User?               @relation("BorrowedProducts", fields: [borrowerId], references: [id])
  creditTransactions CreditTransaction[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("products")
}

enum ProductType {
  GADGET
  FURNITURE
  VEHICLE
  STATIONARY
  MUSICAL_INSTRUMENT
  CLOTHING
  BOOK
  ELECTRONICS
  APARTMENTS
}
