generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(cuid()) @map("id")
  name        String  @map("name")
  email       String  @unique @map("email")
  roll        String  @unique @map("roll")
  password    String  @map("password")
  phoneNumber String  @default("absent") @map("phone_number")
  selfie      String  @default("absent") @map("selfie")
  idCardFront String  @default("absent") @map("id_card_front")
  idCardBack  String  @default("absent") @map("id_card_back")
  ipAddress   String? @map("ip_address")
  latitude    Float?  @map("latitude")
  longitude   Float?  @map("longitude")
  role        Role    @default(USER) @map("role")

  emailVerified   Boolean      @default(false) @map("email_verified")
  isVerified      VerifyStatus @default(UNVERIFIED) @map("is_verified")
  brittooVerified Boolean      @default(false) @map("brittoo_verified")

  otp             String?   @map("otp")
  otpExpiry       DateTime? @map("otp_expiry")
  otpSentCount    Int       @default(0) @map("otp_sent_count")
  lastOtpSentDate DateTime? @map("last_otp_sent_date")

  securityScore   SecurityScore @default(MID) @map("security_score")
  isSuspended     Boolean       @default(false) @map("is_suspended")
  suspensionCount Int           @default(0) @map("suspension_count")

  blueCacheCredits BlueCacheCredit[]
  redCacheCredits  RedCacheCredit[]
  grayCacheCredits GrayCacheCredit[]

  gccRequests GccRequest[]

  rentedProducts   Product[] @relation("ProductsRentedOut")
  borrowedProducts Product[] @relation("ProductsBorrowed")

  rentalRequestsMade     RentalRequest[] @relation("RentalRequestsMade")
  rentalRequestsReceived RentalRequest[] @relation("RentalRequestsReceived")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([latitude, longitude])
  @@map("users")
}

enum VerifyStatus {
  UNVERIFIED
  VERIFIED
  PENDING
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum SecurityScore {
  VERY_LOW
  LOW
  MID
  HIGH
  VERY_HIGH
}

model BlueCacheCredit {
  id             String         @id @default(cuid()) @map("id")
  userId         String         @map("user_id")
  amount         Int            @map("amount")
  paymentGateway PaymentGateway @map("payment_gateway")
  transactionId  String         @map("transaction_id")
  refundTrxIds   String[]       @default([]) @map("refund_trx_ids")

  isActive     Boolean @default(false) @map("is_active")
  isRejected   Boolean @default(false) @map("is_rejected")
  rejectReason String? @map("reject_reason")

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("blue_cache_credits")
}

model RedCacheCredit {
  id              String   @id @default(cuid()) @map("id")
  userId          String   @map("user_id")
  amount          Int      @map("amount")
  sourceProductId String   @map("source_product_id")
  renterId        String   @map("renter_id")
  validityStart   DateTime @map("validity_start")
  validityEnd     DateTime @map("validity_end")

  user          User      @relation(fields: [userId], references: [id])
  sourceProduct Product?  @relation(fields: [sourceProductId], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("red_cache_credits")
}

model GrayCacheCredit {
  id            String   @id @default(cuid()) @map("id")
  amount        Int      @map("amount")
  fee           Int      @map("fee")
  validityStart DateTime @map("validity_start")
  validityEnd   DateTime @map("validity_end")

  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id])
  sourceProductId String?     @map("source_product_id")
  sourceProduct   Product?    @relation(fields: [sourceProductId], references: [id])
  gccRequestId    String?     @unique @map("gcc_request_id")
  gccRequest      GccRequest? @relation(fields: [gccRequestId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("gray_cache_credits")
}

model GccRequest {
  id            String        @id @default(cuid()) @map("id")
  userId        String        @map("user_id")
  gccId         String?       @map("gcc_id")
  phoneNumber   String        @map("phone_number")
  productName   String?       @map("product_name")
  status        GccStatus     @default(PENDING) @map("status")
  depositMethod DepositMethod @map("deposit_method")
  rejectReason  String?       @map("reject_reason")

  address                  String?        @map("address")
  city                     String?        @map("city")
  estimatedDepositDateTime DateTime       @map("estimated_deposit_datetime")
  droppingPoint            DroppingPoint? @map("dropping_point")

  user User             @relation(fields: [userId], references: [id])
  gcc  GrayCacheCredit?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("gcc_requests")
}

enum DepositMethod {
  DROP_AT_PUP
  DEPOSIT_FROM_HOME
}

enum DroppingPoint {
  CSE_1
  ADMIN_1
  BANGABANDHU_HALL_1
  ZIA_HALL_1
  LIBRARY_1
}

enum GccStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentGateway {
  BKASH
  NAGAD
  ROCKET
}

model Product {
  id                 String           @id @default(cuid()) @map("id")
  name               String           @map("name")
  pricePerDay        Float?           @map("price_per_day")
  productImages      String[]         @map("product_images")
  productType        ProductType      @map("product_type")
  productCondition   ProductCondition @map("product_condition")
  productAge         Int              @map("product_age")
  omv                Int              @map("omv")
  secondHandPrice    Int              @map("second_hand_price")
  tags               String           @map("tags")
  productDescription String           @map("product_description")

  ownerId            String  @map("owner_id")
  isOnHold           Boolean @default(false) @map("is_on_hold")
  isForSale          Boolean @default(false) @map("is_for_sale")
  isBrittooVerified  Boolean @default(false) @map("is_brittoo_verified")
  holdCreditValidity Int?    @map("hold_credit_validity")
  owner              User    @relation("ProductsRentedOut", fields: [ownerId], references: [id], onDelete: Cascade)

  borrowers User[] @relation("ProductsBorrowed")

  redCacheCredits  RedCacheCredit[]
  grayCacheCredits GrayCacheCredit[]
  RentalRequest    RentalRequest[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("products")
}

enum ProductType {
  GADGET
  FURNITURE
  VEHICLE
  STATIONARY
  MUSICAL_INSTRUMENT
  CLOTHING
  BOOK
  ACADEMIC_BOOK
  ELECTRONICS
  APARTMENTS
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

model RentalRequest {
  id                 String        @id @default(cuid()) @map("id")
  productId          String        @map("product_id")
  requesterId        String        @map("requester_id")
  ownerId            String        @map("owner_id")
  status             RequestStatus @default(PENDING) @map("status")
  pickupTime         DateTime      @map("pickup_time")
  submissionDeadline DateTime?     @map("submission_deadline")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  requester User    @relation("RentalRequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)
  owner     User    @relation("RentalRequestsReceived", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([ownerId, status])
  @@index([productId, status])
  @@map("rental_requests")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  RECEIVED
  DELIVERED
  CANCELLED
}

model PickupPoint {
  id        String @id @default(cuid()) @map("id")
  name      String @map("name")
  address   String @map("address")
  latitude  Float? @map("latitude")
  longitude Float? @map("longitude")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("pickup_points")
}
