generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(cuid()) @map("id")
  name        String  @map("name")
  email       String  @unique @map("email")
  roll        String  @unique @map("roll")
  password    String  @map("password")
  selfie      String  @default("absent") @map("selfie")
  idCardFront String  @default("absent") @map("id_card_front")
  idCardBack  String  @default("absent") @map("id_card_back")
  ipAddress   String? @map("ip_address")
  latitude    Float?  @map("latitude")
  longitude   Float?  @map("longitude")
  role        Role    @default(USER) @map("role")

  emailVerified   Boolean      @default(false) @map("email_verified")
  isVerified      VerifyStatus @default(UNVERIFIED) @map("is_verified")
  brittooVerified Boolean      @default(false) @map("brittoo_verified")

  otp             String?   @map("otp")
  otpExpiry       DateTime? @map("otp_expiry")
  otpSentCount    Int       @default(0) @map("otp_sent_count")
  lastOtpSentDate DateTime? @map("last_otp_sent_date")

  securityScore   SecurityScore @default(MID) @map("security_score")
  isSuspended     Boolean       @default(false) @map("is_suspended")
  suspensionCount Int           @default(0) @map("suspension_count")

  cacheCredits     CacheCredit[]
  rentedProducts   Product[]     @relation("ProductsRentedOut")
  borrowedProducts Product[]     @relation("ProductsBorrowed")

  rentalRequestsMade     RentalRequest[] @relation("RentalRequestsMade")
  rentalRequestsReceived RentalRequest[] @relation("RentalRequestsReceived")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([latitude, longitude])
  @@map("users")
}

enum VerifyStatus {
  UNVERIFIED
  VERIFIED
  PENDING
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum SecurityScore {
  VERY_LOW
  LOW
  MID
  HIGH
  VERY_HIGH
}

model CacheCredit {
  id              String       @id @default(cuid()) @map("id")
  userId          String       @map("user_id")
  amount          Float        @map("amount")
  creditType      CreditType   @map("credit_type")
  sourceType      CreditSource @map("source_type")
  sourceProductId String?      @map("source_product_id")
  renterId        String?      @map("renter_id")
  instantFee      Float?       @map("instant_fee")
  validityStart   DateTime     @map("validity_start")
  validityEnd     DateTime     @map("validity_end")
  isActive        Boolean      @default(true) @map("is_active")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProduct   Product?     @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  @@map("credit_transactions")
}

enum CreditType {
  BLUE_CC
  RED_CC
}

enum CreditSource {
  PRODUCT
  MONEY
  INSTANT
}

model Product {
  id                 String           @id @default(cuid()) @map("id")
  name               String           @map("name")
  pricePerDay        Float?           @map("price_per_day")
  productImages      String[]         @map("product_images")
  productType        ProductType      @map("product_type")
  productCondition   ProductCondition @map("product_condition")
  productAge         Int              @map("product_age")
  omv                Int              @map("omv")
  tags               String           @map("tags")
  productDescription String           @map("product_description")
  ownerId            String           @map("owner_id")
  isOnHold           Boolean          @default(false) @map("is_on_hold")
  isBrittooVerified  Boolean          @default(false) @map("is_brittoo_verified")
  holdCreditValidity Int?             @map("hold_credit_validity")
  owner              User             @relation("ProductsRentedOut", fields: [ownerId], references: [id], onDelete: Cascade)

  borrowers     User[]          @relation("ProductsBorrowed")
  cacheCredits  CacheCredit[]
  RentalRequest RentalRequest[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("products")
}

enum ProductType {
  GADGET
  FURNITURE
  VEHICLE
  STATIONARY
  MUSICAL_INSTRUMENT
  CLOTHING
  BOOK
  ELECTRONICS
  APARTMENTS
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

model RentalRequest {
  id                 String        @id @default(cuid()) @map("id")
  productId          String        @map("product_id")
  requesterId        String        @map("requester_id")
  ownerId            String        @map("owner_id")
  status             RequestStatus @default(PENDING) @map("status")
  submissionDeadline DateTime?     @map("submission_deadline")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  requester User    @relation("RentalRequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)
  owner     User    @relation("RentalRequestsReceived", fields: [ownerId], references: [id], onDelete: Cascade)

  pickupPointId String?      @map("pickup_point_id")
  pickupPoint   PickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([ownerId, status])
  @@index([productId, status])
  @@map("rental_requests")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  RECEIVED
  DELIVERED
  CANCELLED
}

model PickupPoint {
  id        String   @id @default(cuid()) @map("id")
  name      String   @map("name")
  address   String   @map("address")
  latitude  Float?   @map("latitude")
  longitude Float?   @map("longitude")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rentalRequests RentalRequest[] @relation

  @@map("pickup_points")
}
