generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  roll          String  @unique
  password      String
  selfie        String  @default("absent")
  id_card_front String  @default("absent")
  id_card_back  String  @default("absent")
  ip_address    String?
  latitude      Float?
  longitude     Float?
  role          Role    @default(USER)

  email_verified     Boolean      @default(false)
  is_verified        VerifyStatus @default(UNVERIFIED)
  otp                String?
  otp_expiry         DateTime?
  otp_sent_count     Int          @default(0)
  last_otp_sent_date DateTime?

  safety_score        Int                 @default(0)
  credit_transactions CreditTransaction[] // Tracks all credit transactions for the user

  rented_products   Product[] @relation("RentedProducts")
  borrowed_products Product[] @relation("BorrowedProducts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("users")
}

enum VerifyStatus {
  UNVERIFIED
  VERIFIED
  PENDING
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model CreditTransaction {
  id              String       @id @default(cuid())
  userId          String
  amount          Float
  creditType      CreditType
  sourceType      CreditSource // PRODUCT, MONEY, INSTANT
  sourceProductId String?
  renterId        String?
  instantFee      Float? // Fee charged by Brittoo for instant credit
  validityStart   DateTime
  validityEnd     DateTime
  isActive        Boolean      @default(true)

  user          User     @relation(fields: [userId], references: [id])
  sourceProduct Product? @relation(fields: [sourceProductId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_transactions")
}

enum CreditType {
  BLUE
  RED
}

enum CreditSource {
  PRODUCT
  MONEY
  INSTANT
}

model Product {
  id                  String      @id @default(cuid())
  name                String
  price_per_day       Float?
  product_image       String[]
  product_type        ProductType
  approax_buying_date String
  ownerId             String
  borrowerId          String?
  isOnHold            Boolean     @default(false)
  holdCreditValidity  Int?

  owner              User                @relation("RentedProducts", fields: [ownerId], references: [id])
  borrower           User?               @relation("BorrowedProducts", fields: [borrowerId], references: [id])
  creditTransactions CreditTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

enum ProductType {
  GADGET
  FURNITURE
  VEHICLE
  STATIONARY
  MUSICAL_INSTRUMENT
  CLOTHING
  BOOK
  ELECTRONICS
  APARTMENTS
}
